# ─── Django ───────────────────────────────────────────────────────────────────
# Gere uma chave forte: openssl rand -base64 48
SECRET_KEY=substitua-por-chave-forte-aqui

DEBUG=False

# Domínio(s) separados por vírgula (sem https://)
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# CORS — inclua o protocolo https://
CORS_ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_NAME=administreino_db
DB_USER=adminuser
DB_PASS=substitua-por-senha-forte-aqui
DB_HOST=db
DB_PORT=5432

# ─── Moneyger (opcional) ──────────────────────────────────────────────────────
# Usernames com acesso (além de is_superuser), separados por vírgula
MONEYGER_ALLOWED_USERNAMES=renanrds
# Bot Telegram — não commitar o token real
# URL pública do app, sem barra final. O webhook de produção usa este host.
MONEYGER_PUBLIC_BASE_URL=https://app.exemplo.com
MONEYGER_TELEGRAM_BOT_TOKEN=
MONEYGER_TELEGRAM_WEBHOOK_SECRET=
MONEYGER_TELEGRAM_BOT_USERNAME=
